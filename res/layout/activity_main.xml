<?xml version="1.0" encoding="utf-8"?>
<!--
  背景为一张图片（res/drawable-nodpi/bg_main.png，800x480 与屏幕 1:1）。
  该图已做过逐行自适应压暗：每一行最亮处的纯白文字对比度 >= 5.3:1，
  这样既保住图片本身的蓝→暖渐变，又满足这块低对比度屏的可读性。
  内容层整体不设背景色，直接叠在图上。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_main"
        android:contentDescription="@null" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/space_screen_h"
    android:paddingRight="@dimen/space_screen_h"
    android:paddingTop="@dimen/space_screen_top"
    android:paddingBottom="@dimen/space_screen_bottom">

    <!-- 顶栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="@dimen/topbar_logo"
                android:layout_height="@dimen/topbar_logo"
                android:src="@drawable/ic_logo"
                android:contentDescription="logo" />

            <TextView
                android:id="@+id/brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_item"
                android:text="NAVIDROME"
                android:textColor="@color/text_main"
                android:textSize="11sp"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text=""
            android:textColor="@color/text_main"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- 主体 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_block"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 左：封面 + 信息 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/cover"
                android:layout_width="@dimen/cover_size"
                android:layout_height="@dimen/cover_size"
                android:scaleType="centerCrop"
                android:background="@color/panel"
                android:contentDescription="cover" />

            <!-- 歌名：超宽时自动跑马灯（滚动逻辑见 MarqueeTextView），未超宽则静止左对齐 -->
            <com.tongsir.naviplayer.MarqueeTextView
                android:id="@+id/title"
                android:layout_width="@dimen/cover_size"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/meta_gap"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text="@string/idle"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 歌手：与歌名同一套跑马灯逻辑，超宽才滚、未超宽静止左对齐 -->
            <com.tongsir.naviplayer.MarqueeTextView
                android:id="@+id/artist"
                android:layout_width="@dimen/cover_size"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/meta_gap_sm"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="@color/text_main"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 右：歌词 -->
        <com.tongsir.naviplayer.LyricView
            android:id="@+id/lyric"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/cover_gap"
            android:paddingLeft="@dimen/lyric_pad"
            android:paddingRight="@dimen/lyric_pad" />
    </LinearLayout>

    <!-- 底部控制区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_block"
        android:orientation="vertical">

        <!-- 进度 + 时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/seek_row_height"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/cur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/time_gap"
                android:layout_marginRight="@dimen/time_gap"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/seek_track"
                android:thumb="@drawable/seek_thumb"
                android:splitTrack="false"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
 />

            <TextView
                android:id="@+id/dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-00:00"
                android:textColor="@color/text_main"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 控制按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ctl_row_height"
            android:layout_marginTop="@dimen/space_ctl"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 左：当前音频文件格式 + 码率（无歌曲时整块隐藏） -->
            <LinearLayout
                android:id="@+id/songMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/fmt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_fmt"
                    android:includeFontPadding="false"
                    android:paddingLeft="@dimen/badge_pad_h"
                    android:paddingRight="@dimen/badge_pad_h"
                    android:paddingTop="@dimen/badge_pad_v"
                    android:paddingBottom="@dimen/badge_pad_v"
                    android:singleLine="true"
                    android:textColor="#FF101216"
                    android:textSize="@dimen/badge_text"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/bitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_item"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/text_main"
                    android:textSize="@dimen/meta_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMode"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/mode_height"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingLeft="@dimen/mode_pad"
                android:paddingRight="@dimen/mode_pad"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true">

                <ImageView
                    android:id="@+id/modeIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_order"
                    android:tint="@color/text_main" />

                <TextView
                    android:id="@+id/modeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_item"
                    android:text="@string/mode_order"
                    android:textColor="@color/text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="@dimen/btn_prev_size"
                android:layout_height="@dimen/btn_prev_size"
                android:layout_marginLeft="@dimen/space_ctl"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_prev"
                android:tint="@color/text_main"
                android:scaleType="centerInside"
                android:padding="@dimen/space_item"
                android:contentDescription="prev" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="@dimen/btn_play_size"
                android:layout_height="@dimen/btn_play_size"
                android:layout_marginLeft="@dimen/space_ctl"
                android:layout_marginRight="@dimen/space_ctl"
                android:background="@drawable/bg_play"
                android:src="@drawable/ic_play"
                android:tint="#FF101216"
                android:scaleType="centerInside"
                android:padding="@dimen/space_ctl"
                android:contentDescription="play" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="@dimen/btn_prev_size"
                android:layout_height="@dimen/btn_prev_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_next"
                android:tint="@color/text_main"
                android:scaleType="centerInside"
                android:padding="@dimen/space_item"
                android:contentDescription="next" />

            <!-- 右：服务器连接状态 + 实时延迟（每秒刷新） -->
            <LinearLayout
                android:id="@+id/srvBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|right">

                <ImageView
                    android:id="@+id/srvDot"
                    android:layout_width="@dimen/dot_size"
                    android:layout_height="@dimen/dot_size"
                    android:src="@drawable/ic_dot"
                    android:contentDescription="server status" />

                <TextView
                    android:id="@+id/srvText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dot_gap"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/text_main"
                    android:textSize="@dimen/meta_text"
                    android:typeface="monospace" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

</FrameLayout>
