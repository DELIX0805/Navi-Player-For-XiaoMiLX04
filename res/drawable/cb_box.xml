<?xml version="1.0" encoding="utf-8"?>
<!-- 复选框方框（未勾选）：纯白描边，深底上对比度约 19:1。
     shape 必须写死 size，否则 intrinsicWidth/Height 为 -1，CheckBox 画不出来。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
